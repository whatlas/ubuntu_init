#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 2 ]]; then
    echo "Usage: $0 <directory> <symbol>" >&2
    exit 2
fi

search_dir=$1
symbol=$2

if [[ ! -d "$search_dir" ]]; then
    echo "Directory does not exist: $search_dir" >&2
    exit 1
fi

if ! command -v nm >/dev/null 2>&1; then
    echo "Missing required command: nm" >&2
    exit 1
fi

while IFS= read -r -d '' library; do
    # GNU nm accepts -D for dynamic symbols; Apple nm does not need it.
    if nm -D "$library" 2>/dev/null | grep -Fq -- "$symbol" || \
       nm "$library" 2>/dev/null | grep -Fq -- "$symbol"; then
        printf "Symbol '%s' found in %s\n" "$symbol" "$library"
    fi
done < <(find "$search_dir" -type f \( -name '*.so' -o -name '*.so.*' -o -name '*.dylib' -o -name '*.a' \) -print0)
