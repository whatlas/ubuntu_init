#!/usr/bin/env bash

# Removes local branches whose upstream branch no longer exists.
set -euo pipefail

CYAN="$(tput setaf 6 2>/dev/null || true)"
UNDERLINE="$(tput smul 2>/dev/null || true)"
NOCOLOR="$(tput sgr0 2>/dev/null || true)"

header() {
    printf '\n%s%s%s\n\n' "$UNDERLINE" "$CYAN" "$1$NOCOLOR"
}

branches() {
    git for-each-ref \
        --format='%(refname:short) %(upstream:track)' \
        refs/heads/ |
        awk '$NF == "[gone]" { print $1 }'
}

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "git-cleanup must run inside a Git work tree." >&2
    exit 1
fi

if [[ "${1:-}" != "--force" ]]; then
    stale=$(branches)
    if [[ -n "$stale" ]]; then
        echo "$stale"
        echo "Re-run with --force to delete these branches." >&2
    else
        echo "No local branches have a missing upstream."
    fi
    exit 0
fi

header "Pruning stale remote-tracking branches..."
git fetch --prune --all

stale=$(branches)
if [[ -z "$stale" ]]; then
    echo "No stale local branches found."
    exit 0
fi

header "Deleting local branches with missing upstreams..."
while IFS= read -r branch; do
    [[ -n "$branch" ]] && git branch -D -- "$branch"
done <<< "$stale"
