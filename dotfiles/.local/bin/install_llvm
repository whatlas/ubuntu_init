#!/usr/bin/env zsh

set -euo pipefail

if [[ "$(uname -s)" != Linux ]]; then
    print -u2 "install_llvm is Linux-only. On macOS run: brew install llvm"
    exit 1
fi

if (( $# != 1 )); then
    print -u2 "Usage: ${0:t} <version>"
    exit 2
fi

for command in git cmake ninja; do
    if ! command -v "$command" >/dev/null 2>&1; then
        print -u2 "Missing required command: $command"
        exit 1
    fi
done

version="$1"
workdir=$(mktemp -d "${TMPDIR:-/tmp}/llvm.XXXXXX")

cleanup() {
    local rc=$?
    trap - EXIT INT TERM
    rm -rf -- "$workdir"
    exit "$rc"
}
trap cleanup EXIT INT TERM

echo "Downloading LLVM ${version}"
git clone --depth 1 --branch "llvmorg-${version}" \
    https://github.com/llvm/llvm-project.git "$workdir/llvm-project"

jobs=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
cmake \
    -G Ninja \
    -S "$workdir/llvm-project/llvm" \
    -B "$workdir/build" \
    -DLLVM_ENABLE_PROJECTS="clang;lld;clang-tools-extra;lldb;polly;compiler-rt" \
    -DLLVM_ENABLE_RUNTIMES="libcxx;libcxxabi;libunwind" \
    -DCMAKE_INSTALL_PREFIX="$HOME/.llvm" \
    -DCMAKE_BUILD_TYPE=Release \
    -DLIBCXX_ENABLE_STD_MODULES=ON \
    -DLLVM_ENABLE_ASSERTIONS=ON
cmake --build "$workdir/build" --target install --parallel "$jobs"
